# --- Database ---
# Local dev default (SQLite file via libSQL, zero setup). For production, point
# this at a hosted libSQL/Turso database (https://turso.tech) and it works
# unchanged — Turso is SQLite-compatible and this app talks to it the same way:
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="..." # only needed for a remote Turso database
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Trading engine provider (white-label) ---
# Leave PROVIDER_MODE unset (or "mock") to use the built-in deterministic mock
# provider. Once you've contracted a real white-label prop-firm tech provider,
# fill these in and set PROVIDER_MODE=live.
PROVIDER_MODE="mock"
PROVIDER_API_BASE_URL=""
PROVIDER_API_KEY=""

# --- Trading engine provider (single real MetaApi/MT4 demo account, test-scale) ---
# Set PROVIDER_MODE=metaapi to have the dashboard read live balance/equity from
# one real MT4 demo account via MetaApi (https://metaapi.cloud), instead of the
# mock. Every account in this mode shares the SAME demo account — fine for
# testing with yourself or a couple of people, not a per-customer setup yet.
# METAAPI_TOKEN: API token from your MetaApi account (API Access page).
# METAAPI_ACCOUNT_ID: the MetaApi trading account's own id (not the MT login).
# METAAPI_BASELINE_BALANCE: the balance the demo account started at (e.g. 100000).
METAAPI_TOKEN=""
METAAPI_ACCOUNT_ID=""
METAAPI_BASELINE_BALANCE="100000"
